# Copy this file to cartesi.toml in the application root.
#
# The CLI selects a compatible Cartesi SDK image by default. To make builds
# reproducible across CLI upgrades, pin the SDK image used by your release:
#
# sdk = "cartesi/sdk:<version>"

[machine]
ram_length = "256Mi"
use_docker_env = true
use_docker_workdir = true

# Other supported machine settings include:
# entrypoint = "/usr/local/bin/app"
# boot_args = ["no4lvl", "quiet", "earlycon=sbi", "console=hvc0"]
# max_mcycle = 2305843009213693952
# ram_image = "/usr/share/cartesi-machine/images/linux.bin"
# assert_rolling_template = true
# user = "dapp"
# env_file = ".env.cartesi"

# Define or override values inherited from the Docker image.
[machine.env]
LOG_LEVEL = "info"

# The root drive contains the operating system and application.
[drives.root]
builder = "docker"
context = "."
dockerfile = "Dockerfile"
format = "ext2"
extra_size = "64Mi"
# build_args = ["APP_ENV=production"]
# image = "example/application:latest"
# tags = ["example/application:cartesi"]
# target = "runtime"
# mount = "/"
# shared = false
# user = "dapp"

# A writable data drive mounted inside the Cartesi Machine.
[drives.data]
builder = "empty"
format = "ext2"
size = "128Mi"
mount = "/var/lib/app"
# shared = false
# user = "dapp"

# Additional drives can use one of the following builders. Uncomment only the
# drives needed by the application and ensure the referenced paths exist.
#
# [drives.assets]
# builder = "directory"
# directory = "./assets"
# format = "sqfs"
# extra_size = "32Mi"
# mount = "/opt/assets"
# shared = false
# user = "dapp"
#
# [drives.archive]
# builder = "tar"
# filename = "./data/archive.tar"
# format = "ext2"
# extra_size = "32Mi"
# mount = "/mnt/archive"
# shared = false
# user = "dapp"
#
# [drives.prebuilt]
# builder = "none"
# filename = "./data/reference.sqfs"
# mount = "/opt/reference"
# shared = false
# user = "dapp"

# NVRAMs are raw byte ranges exposed to the guest as /dev/uio0 to /dev/uio7
# (at most 8), with no filesystem and no mount point. Give each one either a
# size (a multiple of 4Ki) or an existing raw image file.
#
# [nvrams.state]
# size = "64Ki"
# shared = false
# user = "dapp"
#
# [nvrams.seed]
# filename = "./data/seed.raw"

# Emergency-withdrawal applications mark exactly one drive or NVRAM as the
# accounts drive. Its size must be a power of two, or set accounts_drive_size
# to keep the accounts in the first bytes of a larger drive.
#
# [drives.accounts]
# builder = "empty"
# format = "raw"
# size = "1Mi"
# mount = "/var/lib/accounts"
# accounts_drive = true
# # accounts_drive_size = "512Ki"
#
# The optional [withdrawal] section then names the deployed contracts. Each
# field has a devnet default, so it can be left out for local runs.
#
# [withdrawal]
# guardian = "0x1111111111111111111111111111111111111111"
# withdrawal_output_builder = "0x2222222222222222222222222222222222222222"
# account_size = 32
#
# See:
# https://docs.cartesi.io/cartesi-rollups/2.0/api-reference/backend/emergency-withdrawal/
